{
  "name": "contextctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "tsc -b --clean && node scripts/clean-workspace-dist.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --exclude packages/ingestion-indexing/test/qdrant-vector-index.integration.test.ts --exclude packages/ingestion-indexing/test/local-embedding-adapter.integration.test.ts --exclude packages/ingestion-indexing/test/document-retrieval-eval.test.ts",
    "test:integration:qdrant": "node scripts/run-external-test.mjs qdrant",
    "test:integration:granite": "node scripts/run-external-test.mjs granite",
    "test:eval:document-retrieval": "node scripts/run-external-test.mjs document-retrieval"
  },
  "dependencies": {
    "@contextctl/daemon": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
