{
  "name": "contextctl",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "tsc -b --clean && node scripts/clean-workspace-dist.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --exclude packages/ingestion-indexing/test/qdrant-vector-index.integration.test.ts --exclude apps/contextctl-daemon/test/qdrant-readiness.integration.test.ts --exclude apps/contextctl-daemon/test/cli/status-populated.integration.test.ts --exclude apps/contextctl-daemon/test/ingestion-maintenance-worker.integration.test.ts --exclude apps/contextctl-daemon/test/state-backup-recovery.integration.test.ts --exclude packages/ingestion-indexing/test/local-embedding-adapter.integration.test.ts --exclude packages/ingestion-indexing/test/document-retrieval-eval.test.ts --exclude packages/ingestion-indexing/test/ingestion-indexing-benchmark.test.ts --exclude apps/contextctl-daemon/test/retained-local-embedding.integration.test.ts --exclude apps/contextctl-daemon/test/embedding-runtime-load.integration.test.ts --exclude apps/contextctl-daemon/test/selection-eval.integration.test.ts --exclude apps/contextctl-daemon/test/generated-card-selection.integration.test.ts --exclude apps/contextctl-daemon/test/selection-scale.integration.test.ts",
    "test:operational": "vitest run packages/ingestion-indexing/test/embedding-pipeline.test.ts packages/ingestion-indexing/test/vector-index-adapters.test.ts packages/ingestion-indexing/test/incremental-reindex-publication.test.ts packages/ingestion-indexing/test/publication-ready-outbox.test.ts packages/ingestion-indexing/test/publication-recovery-intent.test.ts packages/ingestion-indexing/test/ingestion-maintenance.test.ts packages/ingestion-indexing/test/durable-index-catalog.test.ts packages/ingestion-indexing/test/markdown-publication-workflow.test.ts packages/ingestion-indexing/test/published-qdrant-backup-inventory.test.ts apps/contextctl-daemon/test/runtime/ingestion-maintenance-worker.test.ts apps/contextctl-daemon/test/runtime/state-readiness.test.ts apps/contextctl-daemon/test/cli/runtime-options.test.ts apps/contextctl-daemon/test/registry-publication-ready-notifier.test.ts apps/contextctl-daemon/test/operations/state-backup.test.ts apps/contextctl-daemon/test/operations/qdrant-snapshot-archive.test.ts apps/contextctl-daemon/test/cli/vector-backend.test.ts apps/contextctl-daemon/test/cli/required-qdrant-command.test.ts apps/contextctl-daemon/test/cli/meaning-generator.test.ts apps/contextctl-daemon/test/vertical-assembly-end-to-end.test.ts apps/contextctl-daemon/test/runtime/embedding-runtime-scheduler.test.ts apps/contextctl-daemon/test/runtime/prepared-card-catalog.test.ts apps/contextctl-daemon/test/runtime/card-candidate-embedding-priority.test.ts apps/contextctl-daemon/test/embedding/runtime-combinations.test.ts packages/registry-lifecycle/test/domain/fact-grounding.test.ts packages/registry-lifecycle/test/infrastructure/openai-compatible-card-meaning-generator.test.ts",
    "test:release-package": "node scripts/verify-release-package.mjs",
    "test:consumer-install": "node scripts/verify-consumer-install.mjs",
    "test:release-product": "node scripts/verify-release-package.mjs --product-e2e",
    "test:release-product-local": "node scripts/verify-release-package.mjs --product-e2e-local-matrix",
    "release:prepare": "npm run build && node scripts/prepare-release-assets.mjs",
    "release:publish:plan": "node scripts/plan-npm-publish.mjs",
    "release:publish:dry-run": "node scripts/publish-npm-release.mjs dry-run",
    "release:publish:candidate": "node scripts/publish-npm-release.mjs candidate",
    "release:verify:published": "node scripts/verify-published-npm-release.mjs",
    "release:publish:promote": "node scripts/publish-npm-release.mjs promote",
    "test:integration:qdrant": "node scripts/run-external-test.mjs qdrant",
    "test:integration:granite": "node scripts/run-external-test.mjs granite",
    "test:eval:document-retrieval": "node scripts/run-external-test.mjs document-retrieval",
    "test:benchmark:ingestion-indexing": "node scripts/run-external-test.mjs ingestion-indexing-benchmark"
  },
  "dependencies": {
    "@contextctl/daemon": "1.1.2",
    "@huggingface/tokenizers": "0.1.3",
    "onnxruntime-node": "1.29.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
