{
  "name": "@contextctl/utility-evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsc -p tsconfig.json",
    "test": "../../node_modules/.bin/vitest run test",
    "validate": "npm run build && npm test && node --enable-source-maps dist/run.js --validate-only",
    "evaluate": "npm run build && node --enable-source-maps dist/run.js",
    "seal:deferred-v11": "npm run build && node --enable-source-maps dist/seal-deferred-evidence-cover-v11.js",
    "evaluate:deferred-v11": "npm run build && node --enable-source-maps dist/deferred-evidence-cover-v11.js"
  },
  "dependencies": {
    "@contextctl/ingestion-indexing": "1.1.3",
    "@contextctl/selection-delivery": "1.1.3"
  }
}
